# .env.example
# Copy this file to .env and fill in your actual Supabase database credentials.
# Get these from: Supabase Dashboard > Project Settings > Database > Connection Info

SUPABASE_DB_HOST=aws-1-ap-south-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your_project_ref
SUPABASE_DB_PASSWORD=your_database_password
